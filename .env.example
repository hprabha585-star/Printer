# Copy these into hPanel → your Node.js website → Environment variables.
# (On your own PC you may instead copy this file to ".env" and fill it in.)
# Never share these values. Never put them in the code.

# --- MySQL database (from hPanel → Databases → Management) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_printshop
DB_USER=u123456789_printshop
DB_PASSWORD=change-me

# --- Owner master key: first sign-in to /owner, and password recovery ---
# Use 20+ random characters. Keep it on paper somewhere safe.
OWNER_MASTER_KEY=change-me-to-a-long-random-key

# --- Your website address (used in payment return links) ---
PUBLIC_URL=https://print.example.in

# --- Optional limits (defaults shown) ---
# MAX_UPLOAD_MB=25
# MAX_PAGES=200
# MAX_IMAGE_MEGAPIXELS=50
# ANALYSIS_TIMEOUT_SEC=60
# ANALYSIS_CONCURRENCY=2
# UPLOAD_TTL_HOURS=6
# FILE_RETENTION_DAYS=3
# ANALYSE_RATE_LIMIT=30
# SHOP_TZ_OFFSET_MIN=330
# STALE_LOCK_SEC=900

# --- Payment gateway (ONLY after a gateway adapter has been added; see README) ---
# PAYMENT_GATEWAY=razorpay
# GATEWAY_KEY_ID=
# GATEWAY_KEY_SECRET=
# GATEWAY_WEBHOOK_SECRET=
