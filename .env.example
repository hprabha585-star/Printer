# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# MongoDB connection string (MongoDB Atlas free tier works great)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/print_shop

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# Secret key the owner dashboard + print_agent.py must send in the
# "x-owner-key" header to access privileged routes. Make this long & random.
OWNER_KEY=change-me-owner-key

# Public URL of the deployed backend, used to build file download links that
# the print agent (on a different machine) can fetch over the internet.
# Example: https://my-print-shop.onrender.com
PUBLIC_BASE_URL=http://localhost:5000
