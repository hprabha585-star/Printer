# Copy this file to .env for local development.
# On Hostinger, set these as Environment variables in the Node.js app panel
# instead (hPanel > Advanced > Node.js > your app > Environment variables).

# MySQL connection details (from hPanel > Databases > MySQL Databases, or
# your local MySQL/MariaDB install for development).
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Port the server listens on (Hostinger/Render set this automatically in
# production -- you normally don't need to set this yourself there).
PORT=5000

# Secret key the owner dashboard + print agent must send in the
# "x-owner-key" header to access privileged routes. Make this long & random.
# This is only the *first-time* master key -- the owner can set an easier
# everyday password from inside the dashboard afterwards.
OWNER_KEY=change-me-owner-key

# Public URL of the deployed backend, used to build file download links that
# the print agent (on a different machine) can fetch over the internet.
# Example: https://yourdomain.com
PUBLIC_BASE_URL=http://localhost:5000
