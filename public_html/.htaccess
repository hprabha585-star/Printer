# Self-service Print Shop — web server rules (LiteSpeed / Apache)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always use https (the free SSL certificate)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pass the Authorization header to PHP (some servers strip it)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API -> api.php ; nice addresses for the dashboard and first-time setup
  RewriteRule ^api(/.*)?$ api.php [L,QSA]
  RewriteRule ^owner/?$ owner.html [L]
  RewriteRule ^setup/?$ setup.php [L,QSA]

  # Never serve the application code or customer files directly
  RewriteRule ^(app|storage)(/|$) - [F,L]
</IfModule>

# Hide hidden files and notes
<FilesMatch "^\.|\.(md|sql|log|lock|version|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
